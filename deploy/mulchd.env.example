MULCHD_HOST=0.0.0.0
MULCHD_PORT=8000
# python -c "import secrets; print(secrets.token_hex(32))"
MULCHD_SECRET_KEY=

# Your instance's public https:// URL, e.g. https://mulchd.your-domain.com — should
# match MULCHD_HOSTNAME in .env. Required for MCP OAuth (see below) to work; without
# it, mulchd falls back to http://MULCHD_HOST:MULCHD_PORT, which the OAuth authorization
# server routes reject as insecure and silently don't register.
MULCHD_BASE_URL=

# Grants SUPERADMIN to this email on first OAuth login, but only while no
# admin exists yet — becomes permanently inert once any admin grant exists,
# even if this stays set. Leave blank if bootstrapping via the CLI instead
# (see `make bootstrap-admin`).
MULCHD_BOOTSTRAP_ADMIN_EMAIL=

# OAuth — GitHub (optional; omit to disable GitHub login at /connect)
# MULCHD_GITHUB_CLIENT_ID=
# MULCHD_GITHUB_CLIENT_SECRET=

# OAuth — Generic OIDC (optional; works with Google, Entra, Okta, Keycloak, etc.)
# MULCHD_OIDC_DISCOVERY_URL=
# MULCHD_OIDC_CLIENT_ID=
# MULCHD_OIDC_CLIENT_SECRET=
# MULCHD_OIDC_DISPLAY_NAME=Google

# MCP OAuth authorization server (optional; defaults to enabled)
# Lets MCP clients (e.g. Claude Desktop) connect via the standard OAuth
# discovery/registration/consent flow instead of a manually-pasted project token.
# Requires MULCHD_BASE_URL (above) to be set to a public https:// URL (or
# localhost/127.0.0.1 for local testing) — without it, these routes silently don't
# register and mulchd logs a startup warning; the manual project-token flow keeps
# working either way.
# MULCHD_MCP_OAUTH_ENABLED=true
